<MappingRuleSets> 
    <MappingRuleSet name="motor speed configuration">
        <Rule id="Rule_101">
            <TriggerCondition>Set Motor Speed</TriggerCondition>
            <ChangeDescription>Configure Motor Speed</ChangeDescription>
            <EndpointIdentifier>MotorSpeed_SP</EndpointIdentifier>
            <UnitOfChange>RPM</UnitOfChange>
            <MappingVerificationConstraint>&lt;= 900</MappingVerificationConstraint>
        </Rule>
    </MappingRuleSet>

    <MappingRuleSet name="start/stop compressor1">
        <Rule id="Rule_301">
            <TriggerCondition>Start Compressor 1</TriggerCondition>
            <ChangeDescription>Start Compressor 1</ChangeDescription>
            <EndpointIdentifier>Modbus Write M2</EndpointIdentifier>
            <UnitOfChange>none</UnitOfChange>
            <MappingVerificationConstraint>none</MappingVerificationConstraint>
        </Rule>
    </MappingRuleSet>

    <MappingRuleSet name="set network start pressure">
        <Rule id="Rule_401">
            <TriggerCondition>Set Start Pressure</TriggerCondition>
            <ChangeDescription>Set Start Pressure</ChangeDescription>
            <EndpointIdentifier>Switch-On Pressure Slider</EndpointIdentifier>
            <UnitOfChange>10 mbar</UnitOfChange>
            <MappingVerificationConstraint>&gt;= 600 and &lt;= 1100</MappingVerificationConstraint>
        </Rule>
    </MappingRuleSet>

    <MappingRuleSet name="set network stop pressure">
        <Rule id="Rule_501">
            <TriggerCondition>Set Stop Pressure</TriggerCondition>
            <ChangeDescription>Set Stop Pressure</ChangeDescription>
            <EndpointIdentifier>Switch-Off Pressure Slider</EndpointIdentifier>
            <UnitOfChange>10 mbar</UnitOfChange>
            <MappingVerificationConstraint>&gt;= 600 and &lt;= 1100</MappingVerificationConstraint>
        </Rule>
    </MappingRuleSet>


    <MappingRuleSet name="flow rate adjustment">
        <Rule id="Rule_201">
            <TriggerCondition>Any flow rate adjustment request</TriggerCondition> 
            <ChangeDescription>Ensure the mixer is in operation</ChangeDescription>
            <EndpointIdentifier>Mixer_SP</EndpointIdentifier>
            <UnitOfChange>unitless</UnitOfChange>
            <MappingVerificationConstraint>&gt;= 0</MappingVerificationConstraint>
        </Rule>
        
        <Rule id="Rule_202">
            <TriggerCondition>Need to increase flow rate of Material A</TriggerCondition>
            <ChangeDescription>Change the pump's power</ChangeDescription>
            <EndpointIdentifier>Pump_A_Power</EndpointIdentifier>
            <UnitOfChange>kw</UnitOfChange>
            <MappingVerificationConstraint>&lt; 20</MappingVerificationConstraint>
        </Rule>
        
        <Rule id="Rule_203">
            <TriggerCondition>Maintain A:B = 1:3</TriggerCondition>
            <ChangeDescription>Change the pump's power</ChangeDescription>
            <EndpointIdentifier>Pump_B_Power</EndpointIdentifier>
            <UnitOfChange>kw</UnitOfChange>
            <MappingVerificationConstraint>&lt; 20</MappingVerificationConstraint>
        </Rule>
        
        <Rule id="Rule_204">
            <TriggerCondition>Increase total flow by 5 L/min corresponding to a 1% power increase</TriggerCondition>
            <ChangeDescription>Increase heating power by 8%</ChangeDescription>
            <EndpointIdentifier>Heater_Power</EndpointIdentifier>
            <UnitOfChange>kw</UnitOfChange>
            <MappingVerificationConstraint>&lt; 30</MappingVerificationConstraint>
        </Rule>
    </MappingRuleSet>
</MappingRuleSets>



