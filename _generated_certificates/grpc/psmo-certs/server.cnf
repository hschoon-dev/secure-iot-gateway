[ req ]
default_bits       = 4096
prompt             = no
default_md         = sha256
distinguished_name = dn
req_extensions     = v3_req

[ dn ]
CN = grpc-server-psmo

[ v3_req ]
subjectAltName = @alt_names
extendedKeyUsage = serverAuth
keyUsage = digitalSignature, keyEncipherment

[ alt_names ]
DNS.1 = psmo-partition
DNS.2 = localhost
IP.1  = 127.0.0.1
IP.2  = 172.20.128.6
IP.3  = 192.168.0.122