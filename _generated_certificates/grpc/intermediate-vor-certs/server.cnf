[ req ]
default_bits       = 4096
prompt             = no
default_md         = sha256
distinguished_name = dn
req_extensions     = v3_req

[ dn ]
CN = grpc-client-intermediate-vor

[ v3_req ]
subjectAltName = @alt_names
extendedKeyUsage = serverAuth
keyUsage = digitalSignature, keyEncipherment

[ alt_names ]
DNS.1 = intermediate-vor-partition
DNS.2 = localhost
IP.1  = 127.0.0.1
IP.2  = 172.20.128.9
IP.3  = 192.168.0.124
IP.4  = 192.168.156.15