[ req ]
default_bits       = 4096
prompt             = no
default_md         = sha256
distinguished_name = dn
req_extensions     = v3_req

[ dn ]
CN = cpc-partition

[ v3_req ]
subjectAltName = @alt_names
extendedKeyUsage = serverAuth
keyUsage = digitalSignature, keyEncipherment

[ alt_names ]
DNS.1 = cpc-partition
DNS.2 = localhost
IP.1 = 127.0.0.1
IP.2 = 192.168.156.14
